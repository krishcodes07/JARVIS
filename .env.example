# ══════════════════════════════════════════════════════════════
#  JARVIS — Environment Variables Example
#  Copy this file to .env and fill in your actual API keys.
#  NEVER commit .env to version control!
# ══════════════════════════════════════════════════════════════


# ═══ GitHub MCP Integration ═══
GITHUB_PERSONAL_ACCESS_TOKEN=github_pat_...

# ═══ Firecrawl Web Scraping MCP ═══
FIRECRAWL_API_KEY=fc-...

# ═══ Gmail MCP Server Credentials ═══
GMAIL_EMAIL=your_email@gmail.com
GMAIL_APP_PASSWORD="your app password here"
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# ═══ Messaging Connectors (Bridges) ═══
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=

# ═══ Telegram MCP Server (MTProto Userbot) ═══
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_SESSION_STRING="your_generated_session_string_here"

# ═══ Voice (TTS / STT) ═══
# ElevenLabs TTS API key (needed if voice.tts.provider = "elevenlabs")
ELEVENLABS_API_KEY=

# Optional: whisper model cache directory for local STT
# WHISPER_MODEL_DIR=

# ═══ LLM Provider API Keys ═══
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...
GOOGLE_API_KEY=AIzaSy...
NVIDIA_API_KEY=nvapi-...
OPENROUTER_API_KEY=sk-or-v1-...
MISTRAL_API_KEY=...
OPENCODE_ZEN_API_KEY=sk-...
TOGETHER_API_KEY=...
# ... auto added